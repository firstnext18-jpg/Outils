# =============================================================================
# Devra Gestion — variables d'environnement
# =============================================================================
# Copiez ce fichier en `.env` et complétez-le :  cp .env.example .env
# Ne versionnez JAMAIS le fichier `.env` : il contient des secrets.
#
# Les informations de l'entreprise (nom, adresse, IBAN, logo…) ne sont PAS ici :
# elles se règlent dans l'application, page Paramètres → Entreprise.
# =============================================================================


# --- Application --------------------------------------------------------------

# Adresse publique de l'application, sans barre oblique finale.
#   Développement : http://localhost:3000
#   Production    : https://gestion.devra.ch
APP_URL=http://localhost:3000

# Clé secrète qui signe les sessions (32 caractères minimum).
# Générez-en une avec :  openssl rand -base64 32
BETTER_AUTH_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire-de-32-caracteres

# Dossier où l'application enregistre ses fichiers (logo, PDF des factures émises).
# En Docker, il est monté sur un volume (/data) : ne pas modifier. Hors Docker, un
# chemin relatif part du dossier du projet (sauf avec le serveur « standalone »,
# qui démarre dans .next/standalone : préférez alors un chemin absolu).
DATA_DIR=./data

# Fuseau horaire utilisé pour les dates (échéances, tâches planifiées).
TZ=Europe/Zurich


# --- Base de données (PostgreSQL) ---------------------------------------------

# Utilisé par Docker Compose en production pour créer la base.
# Mot de passe : lettres et chiffres uniquement (il est placé dans une URL).
# Générez-en un avec :  openssl rand -hex 24
POSTGRES_USER=devra
POSTGRES_PASSWORD=devra
POSTGRES_DB=devra_gestion

# Adresse de connexion utilisée par l'application et par Prisma.
#   Développement (compose.dev.yaml) : postgresql://devra:devra@localhost:5432/devra_gestion
#   Production : inutile de la changer, Docker Compose la construit à partir
#   des trois variables ci-dessus.
DATABASE_URL=postgresql://devra:devra@localhost:5432/devra_gestion


# --- Sécurité de la connexion -------------------------------------------------

# En-tête HTTP qui contient l'adresse IP réelle du visiteur. Il sert à limiter
# les tentatives de connexion (5 essais par minute et par adresse IP).
#   Cloudflare Tunnel : cf-connecting-ip
#   Caddy             : x-forwarded-for
# Mettre la mauvaise valeur permettrait de contourner la limitation.
AUTH_IP_HEADER=x-forwarded-for

# Limitation des tentatives de connexion. Toujours `true` en production.
# Peut être mis à `false` en développement.
AUTH_RATE_LIMIT=true


# --- Emails (SMTP) ------------------------------------------------------------
# Compatible avec n'importe quel fournisseur (Infomaniak, etc.).
# Exemple Infomaniak : SMTP_HOST=mail.infomaniak.com, SMTP_PORT=465, SMTP_SECURE=true
#
# En développement, Mailpit (compose.dev.yaml) capture tous les emails :
# SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false, sans utilisateur.
# Interface pour les lire : http://localhost:8025

SMTP_HOST=localhost
SMTP_PORT=1025
# true pour le port 465 (TLS direct), false pour 587 (STARTTLS) ou 1025 (Mailpit)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur des emails, ex. : Devra <facturation@devra.ch>
SMTP_FROM=Gestion <gestion@example.ch>


# --- Premier administrateur ---------------------------------------------------
# Utilisé une seule fois, au premier lancement, pour créer le compte admin
# (uniquement si aucun utilisateur n'existe encore). Changez le mot de passe
# après la première connexion, puis vous pouvez vider ces valeurs.

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.ch
# 10 caractères minimum
ADMIN_PASSWORD=
