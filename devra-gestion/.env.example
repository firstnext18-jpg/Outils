# =============================================================================
# Devra Gestion — variables d'environnement
# =============================================================================
# Copiez ce fichier en `.env` et complétez-le :  cp .env.example .env
# Ne versionnez JAMAIS le fichier `.env` : il contient des secrets.
#
# Les informations de l'entreprise (nom, adresse, IBAN, logo…) ne sont PAS ici :
# elles se règlent dans l'application, page Paramètres → Entreprise.
# =============================================================================


# --- Application --------------------------------------------------------------

# Adresse publique de l'application, sans barre oblique finale. Elle sert aussi
# aux liens envoyés par email (invitations, acceptation des devis en ligne) :
# en production, elle doit être accessible depuis Internet.
#   Développement : http://localhost:3000
#   Production    : https://gestion.devra.ch
APP_URL=http://localhost:3000

# Clé secrète qui signe les sessions (32 caractères minimum).
# Générez-en une avec :  openssl rand -base64 32
BETTER_AUTH_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire-de-32-caracteres

# Dossier où l'application enregistre ses fichiers (logo, PDF des factures émises).
# En Docker, il est monté sur un volume (/data) : ne pas modifier. Hors Docker, un
# chemin relatif part du dossier du projet (sauf avec le serveur « standalone »,
# qui démarre dans .next/standalone : préférez alors un chemin absolu).
DATA_DIR=./data

# Fuseau horaire utilisé pour les dates (échéances, tâches planifiées).
TZ=Europe/Zurich


# --- Base de données (PostgreSQL) ---------------------------------------------

# Utilisé par Docker Compose en production pour créer la base.
# Mot de passe : lettres et chiffres uniquement (il est placé dans une URL).
# Générez-en un avec :  openssl rand -hex 24
POSTGRES_USER=devra
POSTGRES_PASSWORD=devra
POSTGRES_DB=devra_gestion

# Adresse de connexion utilisée par l'application et par Prisma.
#   Développement (compose.dev.yaml) : postgresql://devra:devra@localhost:5432/devra_gestion
#   Production : inutile de la changer, Docker Compose la construit à partir
#   des trois variables ci-dessus.
DATABASE_URL=postgresql://devra:devra@localhost:5432/devra_gestion


# --- Sécurité de la connexion -------------------------------------------------

# En-tête HTTP qui contient l'adresse IP réelle du visiteur. Il sert à limiter
# les tentatives de connexion (5 essais par minute et par adresse IP) et à
# enregistrer l'adresse du client qui accepte un devis en ligne.
#   Cloudflare Tunnel : cf-connecting-ip
#   Caddy             : x-forwarded-for
# Mettre la mauvaise valeur permettrait de contourner la limitation.
AUTH_IP_HEADER=x-forwarded-for

# Limitation des tentatives de connexion. Toujours `true` en production.
# Peut être mis à `false` en développement.
AUTH_RATE_LIMIT=true


# --- Emails (SMTP) ------------------------------------------------------------
# Compatible avec n'importe quel fournisseur (Infomaniak, etc.).
# Exemple Infomaniak : SMTP_HOST=mail.infomaniak.com, SMTP_PORT=465, SMTP_SECURE=true
#
# En développement, Mailpit (compose.dev.yaml) capture tous les emails :
# SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_SECURE=false, sans utilisateur.
# Interface pour les lire : http://localhost:8025

SMTP_HOST=localhost
SMTP_PORT=1025
# true pour le port 465 (TLS direct), false pour 587 (STARTTLS) ou 1025 (Mailpit)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur des emails, ex. : Devra <facturation@devra.ch>
SMTP_FROM=Gestion <gestion@example.ch>


# --- Tâches quotidiennes -------------------------------------------------------
# Chaque matin, le conteneur « cron » appelle l'application pour passer les devis
# échus en « expiré », générer les factures d'abonnement et traiter les relances.
# Secret partagé entre les deux conteneurs (32 caractères minimum) :
#   openssl rand -base64 32
CRON_SECRET=
# Heure d'exécution (heure de Zurich)
CRON_TIME=06:00


# --- Sauvegardes (service « backup ») -------------------------------------------
# Chaque jour, la base et les fichiers (logo, PDF) sont sauvegardés dans
# BACKUP_DIR, puis les sauvegardes trop anciennes sont supprimées.
# Voir docs/SAUVEGARDES.md (fonctionnement et restauration).

# Dossier des sauvegardes sur le Raspberry Pi. Idéalement un disque USB ou un
# partage réseau (NAS) monté à cet endroit, pour ne pas tout perdre avec la carte SD.
BACKUP_DIR=./sauvegardes
# Heure de la sauvegarde (heure de Zurich)
BACKUP_TIME=02:30
# Nombre de jours de conservation
BACKUP_RETENTION_DAYS=30

# Copie hors du Raspberry Pi (facultatif) avec rclone, vers n'importe quel
# stockage (Infomaniak kDrive ou Swiss Backup, SFTP, S3…). Laisser vide pour
# ne pas copier. Format « nom-du-stockage:dossier », ex. : distant:devra-sauvegardes
BACKUP_REMOTE=
# Le stockage se décrit avec des variables RCLONE_CONFIG_<NOM>_<OPTION>
# (https://rclone.org/docs/#config-file). Exemple WebDAV (ex. kDrive), nom « DISTANT » :
#   RCLONE_CONFIG_DISTANT_TYPE=webdav
#   RCLONE_CONFIG_DISTANT_URL=<adresse WebDAV indiquée par le fournisseur>
#   RCLONE_CONFIG_DISTANT_VENDOR=other
#   RCLONE_CONFIG_DISTANT_USER=prenom@exemple.ch
#   RCLONE_CONFIG_DISTANT_PASS=<mot de passe chiffré par : docker compose run --rm --entrypoint rclone backup obscure 'mot-de-passe'>
# Chiffrement côté Raspberry Pi recommandé (remote « crypt ») : voir docs/SAUVEGARDES.md.


# --- Accès HTTPS depuis Internet (production) --------------------------------
# Choisissez UNE des deux options (voir docs/DEPLOIEMENT_RASPBERRY_PI.md) en
# décommentant la ligne COMPOSE_FILE correspondante :
#
# 1. Cloudflare Tunnel (recommandé, aucun port à ouvrir sur la box) :
# COMPOSE_FILE=compose.yaml:compose.cloudflare.yaml
# Jeton du tunnel (tableau de bord Cloudflare → Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
#    avec AUTH_IP_HEADER=cf-connecting-ip (ci-dessus)
#
# 2. Caddy (ports 80 et 443 redirigés par la box vers le Raspberry Pi) :
# COMPOSE_FILE=compose.yaml:compose.caddy.yaml
# Nom de domaine et email pour le certificat Let's Encrypt
DOMAIN=gestion.devra.ch
ACME_EMAIL=
#    avec AUTH_IP_HEADER=x-forwarded-for (ci-dessus)


# --- Images de l'application (production) -----------------------------------
# Raspberry Pi : les images sont construites par GitHub Actions et téléchargées
# depuis GitHub Container Registry (le Pi ne les construit pas). Indiquez
# ghcr.io/<compte GitHub en minuscules>, puis : docker login ghcr.io,
# docker compose pull, docker compose up -d --no-build.
# Vide : les images sont construites sur place (docker compose up -d --build).
IMAGE_REGISTRY=
# Version des images : « latest » (la plus récente), ou « sha-<7 premiers caractères
# du commit> » pour revenir à une version précédente.
IMAGE_TAG=latest


# --- Premier administrateur ---------------------------------------------------
# Utilisé une seule fois, au premier lancement, pour créer le compte admin
# (uniquement si aucun utilisateur n'existe encore). Changez le mot de passe
# après la première connexion, puis vous pouvez vider ces valeurs.

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.ch
# 10 caractères minimum
ADMIN_PASSWORD=
