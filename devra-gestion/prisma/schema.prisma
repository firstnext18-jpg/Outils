// Schéma de la base de données de Devra Gestion.
//
// Conventions (voir docs/DECISIONS.md) :
// - identifiants UUID v7 (triables par date de création) ;
// - montants en centimes (Int), pourcentages en points de base (10 % = 1000),
//   quantités en millièmes (1,5 h = 1500) — à partir de la phase 4 ;
// - les tables d'authentification (user, session, account, verification,
//   rate_limit) suivent le format attendu par Better Auth.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Rôles des utilisateurs, du plus élevé au plus faible.
enum Role {
  ADMIN
  MEMBER
  READONLY
}

// ---------------------------------------------------------------------------
// Authentification (Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid(7))
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(MEMBER)
  /// Un utilisateur désactivé ne peut plus se connecter (ses sessions sont supprimées).
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions        Session[]
  accounts        Account[]
  activities      ActivityLog[]
  invitationsSent Invitation[]   @relation("InvitedBy")
  settingsUpdates Settings[]
  clientsCreated  Client[]       @relation("ClientCreatedBy")
  clientsUpdated  Client[]       @relation("ClientUpdatedBy")
  catalogCreated  CatalogItem[]  @relation("CatalogItemCreatedBy")
  catalogUpdated  CatalogItem[]  @relation("CatalogItemUpdatedBy")
  quotesCreated   Quote[]        @relation("QuoteCreatedBy")
  quotesUpdated   Quote[]        @relation("QuoteUpdatedBy")
  invoicesCreated Invoice[]      @relation("InvoiceCreatedBy")
  invoicesUpdated Invoice[]      @relation("InvoiceUpdatedBy")
  payments        Payment[]
  emailsSent      EmailLog[]
  remindersSent   Reminder[]
  subsCreated     Subscription[] @relation("SubscriptionCreatedBy")
  subsUpdated     Subscription[] @relation("SubscriptionUpdatedBy")
  taskRuns        TaskRun[]

  discussionsCreated      Discussion[]        @relation("DiscussionCreatedBy")
  discussionMessages      DiscussionMessage[]
  discussionReads         DiscussionRead[]
  pushSubscriptions       PushSubscription[]
  notifications           Notification[]
  clientAccounts          ClientAccount[]     @relation("ClientAccountCreatedBy")
  filesUploaded           StoredFile[]
  projectsCreated         Project[]           @relation("ProjectCreatedBy")
  stepsDone               ProjectStep[]
  timeEntries             TimeEntry[]
  expensesCreated         Expense[]           @relation("ExpenseCreatedBy")
  partnerMovements        PartnerMovement[]   @relation("PartnerMovements")
  partnerMovementsCreated PartnerMovement[]   @relation("PartnerMovementCreatedBy")
  bankImports             BankImport[]
  calendarFeed            CalendarFeed?

  @@map("user")
}

model Session {
  id        String   @id @default(uuid(7))
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Compte de connexion. Pour l'email + mot de passe : providerId = "credential"
/// et `password` contient l'empreinte Argon2id.
model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Jetons temporaires de Better Auth (réinitialisation du mot de passe).
model Verification {
  id         String   @id @default(uuid(7))
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Compteurs de la limitation des tentatives (connexion, mot de passe oublié).
model RateLimit {
  id          String @id @default(uuid(7))
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ---------------------------------------------------------------------------
// Utilisateurs : invitations
// ---------------------------------------------------------------------------

/// Invitation envoyée par un admin. Seule l'empreinte SHA-256 du jeton est
/// stockée : le jeton lui-même n'existe que dans le lien envoyé par email.
model Invitation {
  id          String    @id @default(uuid(7))
  email       String
  name        String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Paramètres
// ---------------------------------------------------------------------------

/// Paramètres de l'application : une seule ligne (id = 1).
/// Les informations de l'entreprise ne sont jamais écrites dans le code.
model Settings {
  id Int @id @default(1)

  companyName         String  @default("")
  companyStreet       String  @default("")
  companyStreetNumber String  @default("")
  companyPostalCode   String  @default("")
  companyCity         String  @default("")
  /// Code pays ISO 3166-1 alpha-2.
  companyCountry      String  @default("CH")
  companyEmail        String  @default("")
  companyPhone        String  @default("")
  companyWebsite      String  @default("")
  /// IBAN classique (références SCOR sur la QR-facture). Stocké sans espaces.
  iban                String  @default("")
  /// QR-IBAN (références QRR sur la QR-facture). Stocké sans espaces.
  qrIban              String  @default("")
  /// Préfixe des références QRR imposé par certaines banques (chiffres, facultatif).
  qrReferencePrefix   String  @default("")
  /// Nom du fichier du logo dans DATA_DIR/uploads.
  logoFile            String?

  /// Formats de numérotation (voir src/domain/numbering.ts).
  quoteNumberFormat   String  @default("D-{AAAA}-{NNN}")
  invoiceNumberFormat String  @default("F-{AAAA}-{NNN}")
  /// Délais par défaut, en jours.
  quoteValidityDays   Int     @default(30)
  paymentTermDays     Int     @default(15)
  /// Acceptation des devis en ligne : lien envoyé avec le devis (variable {lien}).
  onlineAcceptance    Boolean @default(false)

  /// TVA : désactivée tant que l'entreprise n'y est pas assujettie.
  vatEnabled Boolean @default(false)
  /// Numéro TVA (ex. CHE-123.456.789 TVA), affiché sur les documents quand la TVA est activée.
  vatNumber  String  @default("")
  /// Taux proposés, en points de base (8,1 % = 810). Le premier est le taux par défaut.
  vatRates   Int[]   @default([810, 260, 380])

  /// Textes par défaut des documents, en français et en allemand.
  quoteIntroFr          String       @default("Nous vous remercions de l'intérêt que vous portez à nos services et avons le plaisir de vous soumettre notre offre.")
  quoteIntroDe          String       @default("Vielen Dank für Ihr Interesse an unseren Dienstleistungen. Gerne unterbreiten wir Ihnen unsere Offerte.")
  quoteConditionsFr     String       @default("Les prix s'entendent en francs suisses. La facture est payable dans le délai indiqué sur celle-ci. Nous restons à votre disposition pour toute question.")
  quoteConditionsDe     String       @default("Alle Preise verstehen sich in Schweizer Franken. Die Rechnung ist innerhalb der darauf angegebenen Frist zahlbar. Für Fragen stehen wir Ihnen gerne zur Verfügung.")
  invoiceIntroFr        String       @default("Nous vous remercions de votre confiance et vous adressons notre facture.")
  invoiceIntroDe        String       @default("Vielen Dank für Ihr Vertrauen. Gerne stellen wir Ihnen unsere Leistungen in Rechnung.")
  invoiceConditionsFr   String       @default("Merci de régler ce montant d'ici à l'échéance indiquée, de préférence au moyen de la QR-facture ci-dessous.")
  invoiceConditionsDe   String       @default("Bitte begleichen Sie den Betrag bis zum angegebenen Fälligkeitsdatum, vorzugsweise mit der untenstehenden QR-Rechnung.")
  /// Modèles des emails d'envoi (variables : voir src/domain/email-template.ts).
  quoteEmailSubjectFr   String       @default("Devis {numero}")
  quoteEmailSubjectDe   String       @default("Offerte {numero}")
  quoteEmailBodyFr      String       @default("Bonjour,\n\nVeuillez trouver ci-joint notre devis {numero} d'un montant de {montant}, valable jusqu'au {echeance}.\n\nVous pouvez le consulter et l'accepter en ligne : {lien}\n\nNous restons à votre disposition pour toute question.\n\nMeilleures salutations\n{entreprise}")
  quoteEmailBodyDe      String       @default("Guten Tag\n\nBeiliegend erhalten Sie unsere Offerte {numero} über {montant}, gültig bis {echeance}.\n\nSie können die Offerte online ansehen und annehmen: {lien}\n\nFür Fragen stehen wir Ihnen gerne zur Verfügung.\n\nFreundliche Grüsse\n{entreprise}")
  invoiceEmailSubjectFr String       @default("Facture {numero}")
  invoiceEmailSubjectDe String       @default("Rechnung {numero}")
  invoiceEmailBodyFr    String       @default("Bonjour,\n\nVeuillez trouver ci-joint notre facture {numero} d'un montant de {montant}, payable d'ici au {echeance}. Le bulletin de paiement (QR-facture) figure au bas du document.\n\nNous vous remercions de votre confiance.\n\nMeilleures salutations\n{entreprise}")
  /// Relances : mode, délais (jours), frais (centimes), délai de paiement accordé.
  reminderMode          ReminderMode @default(MANUAL)
  reminderDelay1        Int          @default(10)
  reminderDelay2        Int          @default(15)
  reminderDelay3        Int          @default(15)
  reminderFee1Cents     Int          @default(0)
  reminderFee2Cents     Int          @default(0)
  reminderFee3Cents     Int          @default(0)
  reminderPaymentDays   Int          @default(10)
  /// Textes des relances (objet + texte, par niveau et par langue) ; null = textes par défaut.
  reminderTemplates     Json?
  /// Abonnements : les factures générées partent directement par email (sinon : brouillons).
  subscriptionAutoSend  Boolean      @default(false)

  invoiceEmailBodyDe String @default("Guten Tag\n\nBeiliegend erhalten Sie unsere Rechnung {numero} über {montant}, zahlbar bis {echeance}. Den Einzahlungsschein (QR-Rechnung) finden Sie unten auf dem Dokument.\n\nVielen Dank für Ihr Vertrauen.\n\nFreundliche Grüsse\n{entreprise}")

  documentFooterFr String @default("")
  documentFooterDe String @default("")

  /// Relance des devis : email au client quelques jours avant la fin de validité.
  quoteReminderEnabled   Boolean @default(false)
  quoteReminderDays      Int     @default(3)
  quoteReminderSubjectFr String  @default("Rappel : devis {numero}")
  quoteReminderSubjectDe String  @default("Erinnerung: Offerte {numero}")
  quoteReminderBodyFr    String  @default("Bonjour,\n\nNotre devis {numero} d'un montant de {montant} est valable jusqu'au {echeance}.\n\nVous pouvez le consulter et nous donner votre réponse en ligne : {lien}\n\nNous restons à votre disposition pour toute question.\n\nMeilleures salutations\n{entreprise}")
  quoteReminderBodyDe    String  @default("Guten Tag\n\nUnsere Offerte {numero} über {montant} ist gültig bis {echeance}.\n\nSie können sie online ansehen und uns Ihre Antwort geben: {lien}\n\nFür Fragen stehen wir Ihnen gerne zur Verfügung.\n\nFreundliche Grüsse\n{entreprise}")

  /// Suivi du temps : tarif horaire par défaut des projets (centimes, hors TVA ; 0 = à définir).
  hourlyRateCents     Int     @default(0)
  /// Renouvellements des domaines, hébergements et certificats : rappel N jours avant.
  renewalReminderDays Int     @default(30)
  /// Surveillance des sites : alerte aussi par email à l'équipe (en plus des notifications).
  monitorAlertEmail   Boolean @default(true)

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Clients
// ---------------------------------------------------------------------------

enum ClientKind {
  INDIVIDUAL
  COMPANY
}

/// Langue des documents envoyés au client (devis, factures, emails).
enum DocumentLanguage {
  FR
  DE
}

/// Les 26 cantons suisses (codes officiels).
enum Canton {
  AG
  AI
  AR
  BE
  BL
  BS
  FR
  GE
  GL
  GR
  JU
  LU
  NE
  NW
  OW
  SG
  SH
  SO
  SZ
  TG
  TI
  UR
  VD
  VS
  ZG
  ZH
}

/// Types de sites proposés (liste modifiable dans Paramètres → Types de sites).
model SiteType {
  id        String   @id @default(uuid(7))
  name      String   @unique
  position  Int      @default(0)
  /// Un type désactivé n'est plus proposé, mais reste affiché sur les fiches existantes.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients  Client[]
  quotes   Quote[]
  invoices Invoice[]

  @@map("site_type")
}

model Client {
  id   String     @id @default(uuid(7))
  kind ClientKind

  /// Particulier
  firstName   String @default("")
  lastName    String @default("")
  /// Entreprise
  companyName String @default("")
  contactName String @default("")
  /// Nom affiché : raison sociale, ou « Prénom Nom ».
  displayName String
  /// Clé de tri du nom (minuscules, sans accents) : « Émile » se range avec les E.
  sortName    String @default("")
  /// Texte de recherche (minuscules, sans accents) : « zurich » trouve « Zürich ».
  searchText  String @default("")

  street       String  @default("")
  streetNumber String  @default("")
  postalCode   String  @default("")
  city         String  @default("")
  canton       Canton?
  /// Code pays ISO 3166-1 alpha-2.
  country      String  @default("CH")

  /// Enregistré en minuscules (détection des doublons).
  email   String @default("")
  phone   String @default("")
  website String @default("")

  siteTypeId String?
  siteType   SiteType?        @relation(fields: [siteTypeId], references: [id], onDelete: SetNull)
  /// État du suivi (« À contacter », « Projet en cours »…), liste modifiable dans les paramètres.
  stageId    String?
  stage      ListItem?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  language   DocumentLanguage @default(FR)
  notes      String           @default("")
  tags       String[]         @default([])

  /// Un client archivé n'apparaît plus dans la liste par défaut.
  archivedAt DateTime?
  /// Incrémenté à chaque modification : empêche d'écraser le travail d'un autre utilisateur.
  version    Int       @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("ClientUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  quotes        Quote[]
  invoices      Invoice[]
  subscriptions Subscription[]
  discussions   Discussion[]
  /// Accès à l'espace client (identifiant et mot de passe), s'il a été créé.
  account       ClientAccount?
  files         StoredFile[]
  projects      Project[]
  timeEntries   TimeEntry[]
  expenses      Expense[]
  sites         Site[]

  @@index([sortName])
  @@index([stageId])
  @@index([email])
  @@index([archivedAt])
  @@index([canton])
  @@index([tags], type: Gin)
  @@map("client")
}

// ---------------------------------------------------------------------------
// Catalogue de prestations
// ---------------------------------------------------------------------------

/// Type de ligne d'un devis ou d'une facture.
enum LineType {
  /// Forfait (ex. « Site vitrine 5 pages »)
  FLAT
  /// À l'heure (quantité en heures)
  HOURLY
  /// Supplément (ex. « Page supplémentaire »)
  EXTRA
  /// Abonnement, facturé périodiquement (ex. « Hébergement + maintenance »)
  SUBSCRIPTION
}

enum Periodicity {
  MONTHLY
  QUARTERLY
  YEARLY
}

/// Unités des lignes, traduites sur les documents (voir src/domain/units.ts).
enum Unit {
  FLAT
  HOUR
  PIECE
  PAGE
  DAY
  MONTH
  QUARTER
  YEAR
}

/// Prestation réutilisable dans les devis et factures. Prix hors TVA, en centimes.
model CatalogItem {
  id             String       @id @default(uuid(7))
  name           String
  /// Nom utilisé sur les documents en allemand (facultatif : sinon le nom français).
  nameDe         String       @default("")
  description    String       @default("")
  descriptionDe  String       @default("")
  category       String       @default("")
  lineType       LineType
  unit           Unit
  unitPriceCents Int
  /// Obligatoire pour un abonnement, vide sinon.
  periodicity    Periodicity?
  active         Boolean      @default(true)
  /// Texte de recherche (minuscules, sans accents).
  searchText     String       @default("")
  version        Int          @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("CatalogItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("CatalogItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  quoteLines        QuoteLine[]
  invoiceLines      InvoiceLine[]
  subscriptionItems SubscriptionItem[]

  @@index([active])
  @@index([category])
  @@map("catalog_item")
}

// ---------------------------------------------------------------------------
// Numérotation et devis
// ---------------------------------------------------------------------------

/// Remise ou acompte : en pourcentage (points de base) ou en montant (centimes).
enum DiscountType {
  PERCENT
  AMOUNT
}

enum SequenceKind {
  QUOTE
  INVOICE
}

/// Dernier numéro attribué, par type de document et par année. Incrémenté dans
/// la transaction qui crée le document : deux documents ne peuvent pas recevoir
/// le même numéro, et un numéro n'est jamais sauté.
model NumberSequence {
  kind      SequenceKind
  year      Int
  lastValue Int
  updatedAt DateTime     @updatedAt

  @@id([kind, year])
  @@map("number_sequence")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REFUSED
  EXPIRED
}

model Quote {
  id       String @id @default(uuid(7))
  /// Ex. D-2026-001, attribué à la création.
  number   String @unique
  year     Int
  sequence Int

  clientId   String
  /// Un client lié à des devis ne peut pas être supprimé (seulement archivé).
  client     Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  status     QuoteStatus      @default(DRAFT)
  language   DocumentLanguage
  issueDate  DateTime         @db.Date
  validUntil DateTime         @db.Date
  subject    String           @default("")
  siteTypeId String?
  siteType   SiteType?        @relation(fields: [siteTypeId], references: [id], onDelete: SetNull)

  introText      String @default("")
  conditionsText String @default("")

  globalDiscountType  DiscountType?
  /// Points de base (PERCENT) ou centimes (AMOUNT).
  globalDiscountValue Int           @default(0)
  depositType         DiscountType?
  depositValue        Int           @default(0)
  /// TVA appliquée à ce devis (reprend le paramètre au moment de l'enregistrement).
  vatEnabled          Boolean       @default(false)

  /// Totaux recalculés à chaque enregistrement (listes, statistiques).
  subtotalCents           Int @default(0)
  discountCents           Int @default(0)
  vatCents                Int @default(0)
  /// Montant unique, arrondi aux 5 centimes.
  totalCents              Int @default(0)
  depositCents            Int @default(0)
  recurringMonthlyCents   Int @default(0)
  recurringQuarterlyCents Int @default(0)
  recurringYearlyCents    Int @default(0)

  sentAt          DateTime?
  /// Date d'acceptation ou de refus.
  decidedAt       DateTime?
  /// Décision prise en ligne par le client : nom saisi, adresse IP, commentaire (refus).
  decidedOnline   Boolean   @default(false)
  decisionName    String    @default("")
  decisionIp      String    @default("")
  decisionComment String    @default("")
  /// Coordonnées du client et de l'entreprise figées à l'envoi (PDF identique ensuite).
  clientSnapshot  Json?
  companySnapshot Json?

  /// Numéro et objet, sans accents (recherche).
  searchText String @default("")
  version    Int    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("QuoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  /// Relance avant la fin de validité (automatique ou manuelle) : une seule par devis envoyé.
  reminderSentAt DateTime?

  lines         QuoteLine[]
  invoices      Invoice[]
  emails        EmailLog[]
  subscriptions Subscription[]
  links         QuoteLink[]
  projects      Project[]

  @@index([clientId])
  @@index([status])
  @@index([issueDate])
  @@map("quote")
}

/// Lien d'acceptation en ligne d'un devis. Seule l'empreinte (SHA-256) du jeton est enregistrée.
model QuoteLink {
  id        String   @id @default(uuid(7))
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([quoteId])
  @@map("quote_link")
}

/// Ligne de devis : copie complète des données (indépendante du catalogue).
model QuoteLine {
  id            String       @id @default(uuid(7))
  quoteId       String
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position      Int
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  lineType       LineType
  periodicity    Periodicity?
  label          String
  description    String        @default("")
  /// Quantité en millièmes (1,5 h = 1500).
  quantityMilli  Int
  unit           Unit
  unitPriceCents Int
  discountType   DiscountType?
  discountValue  Int           @default(0)
  vatRateBps     Int?
  /// Montant net de la ligne (après remise de ligne), en centimes.
  netCents       Int

  @@index([quoteId])
  @@map("quote_line")
}

// ---------------------------------------------------------------------------
// Factures et paiements
// ---------------------------------------------------------------------------

enum InvoiceType {
  STANDARD
  /// Acompte demandé à la commande (devis avec acompte).
  DEPOSIT
  /// Solde après acompte : reprend tout le devis et déduit les acomptes facturés.
  FINAL
  /// Période d'un abonnement (phase 7).
  SUBSCRIPTION
}

/// « En retard » n'est pas un statut enregistré : il se calcule d'après l'échéance.
enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ReferenceType {
  QRR
  SCOR
  NON
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  TWINT
  OTHER
}

model Invoice {
  id       String  @id @default(uuid(7))
  /// Ex. F-2026-001, attribué à l'émission : un brouillon supprimé ne laisse pas de trou.
  number   String? @unique
  year     Int?
  sequence Int?

  type       InvoiceType      @default(STANDARD)
  status     InvoiceStatus    @default(DRAFT)
  clientId   String
  /// Un client qui a des factures ne peut pas être supprimé (seulement archivé).
  client     Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Devis d'origine (conversion).
  quoteId    String?
  quote      Quote?           @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  language   DocumentLanguage
  issueDate  DateTime         @db.Date
  dueDate    DateTime         @db.Date
  subject    String           @default("")
  siteTypeId String?
  siteType   SiteType?        @relation(fields: [siteTypeId], references: [id], onDelete: SetNull)

  introText      String @default("")
  conditionsText String @default("")

  globalDiscountType  DiscountType?
  globalDiscountValue Int           @default(0)
  vatEnabled          Boolean       @default(false)

  /// Totaux recalculés à chaque enregistrement.
  subtotalCents  Int   @default(0)
  discountCents  Int   @default(0)
  vatCents       Int   @default(0)
  /// Total de la facture, arrondi aux 5 centimes.
  totalCents     Int   @default(0)
  /// Facture finale : acomptes déduits [{ invoiceId, number, amountCents }].
  deductions     Json?
  deductedCents  Int   @default(0)
  /// Montant à payer : total − acomptes déduits.
  amountDueCents Int   @default(0)
  /// Frais de relance facturés (ajoutés au solde).
  feesCents      Int   @default(0)
  /// Somme des paiements enregistrés.
  paidCents      Int   @default(0)

  /// Facture d'abonnement : abonnement et période facturée (jamais deux fois la même).
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  periodStart    DateTime?     @db.Date
  periodEnd      DateTime?     @db.Date

  issuedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String    @default("")

  /// Compte, type et référence de paiement de la QR-facture, fixés à l'émission.
  paymentAccount   String         @default("")
  referenceType    ReferenceType?
  paymentReference String         @default("")

  /// Coordonnées du client et de l'entreprise figées à l'émission.
  clientSnapshot  Json?
  companySnapshot Json?
  /// PDF archivé à l'émission (dans DATA_DIR/documents).
  pdfFile         String?

  searchText String @default("")
  version    Int    @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  lines       InvoiceLine[]
  payments    Payment[]
  emails      EmailLog[]
  reminders   Reminder[]
  /// Heures facturées par cette facture (suivi du temps).
  timeEntries TimeEntry[]

  @@unique([subscriptionId, periodStart])
  @@index([clientId])
  @@index([quoteId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
  @@map("invoice")
}

/// Ligne de facture : mêmes champs qu'une ligne de devis.
model InvoiceLine {
  id            String       @id @default(uuid(7))
  invoiceId     String
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position      Int
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  lineType       LineType
  periodicity    Periodicity?
  label          String
  description    String        @default("")
  quantityMilli  Int
  unit           Unit
  unitPriceCents Int
  discountType   DiscountType?
  discountValue  Int           @default(0)
  vatRateBps     Int?
  netCents       Int

  @@index([invoiceId])
  @@map("invoice_line")
}

model Payment {
  id              String           @id @default(uuid(7))
  invoiceId       String
  /// Une facture qui a des paiements ne peut pas être supprimée.
  invoice         Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  date            DateTime         @db.Date
  amountCents     Int
  method          PaymentMethod
  note            String           @default("")
  createdAt       DateTime         @default(now())
  createdById     String?
  createdBy       User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  /// Opération du relevé bancaire d'où vient ce paiement (import camt).
  bankTransaction BankTransaction?

  @@index([invoiceId])
  @@index([date])
  @@map("payment")
}

// ---------------------------------------------------------------------------
// Relances
// ---------------------------------------------------------------------------

enum ReminderMode {
  /// L'outil propose les relances, un utilisateur les valide.
  MANUAL
  /// La tâche quotidienne les envoie par email.
  AUTOMATIC
}

enum ReminderChannel {
  EMAIL
  /// Envoyée autrement (courrier) : seulement enregistrée.
  MANUAL
}

model Reminder {
  id           String          @id @default(uuid(7))
  invoiceId    String
  invoice      Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  /// 1 : rappel, 2 : 2e rappel, 3 : mise en demeure.
  level        Int
  date         DateTime        @db.Date
  /// Nouveau délai de paiement accordé.
  dueDate      DateTime        @db.Date
  /// Solde avant cette relance, frais de cette relance, total demandé.
  balanceCents Int
  feeCents     Int
  totalCents   Int
  channel      ReminderChannel
  /// Texte de la lettre (variables remplacées), pour régénérer le PDF si besoin.
  text         String          @default("")
  /// PDF archivé (DATA_DIR/documents/reminders).
  pdfFile      String?
  /// Vide pour une relance envoyée automatiquement.
  createdById  String?
  createdBy    User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  emails EmailLog[]

  @@unique([invoiceId, level])
  @@map("reminder")
}

// ---------------------------------------------------------------------------
// Abonnements
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

model Subscription {
  id              String             @id @default(uuid(7))
  clientId        String
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Devis d'origine.
  quoteId         String?
  quote           Quote?             @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  status          SubscriptionStatus @default(ACTIVE)
  periodicity     Periodicity
  language        DocumentLanguage
  /// Libellé court (ex. « Hébergement + maintenance »).
  label           String
  startDate       DateTime           @db.Date
  /// Nombre de périodes déjà facturées et début de la prochaine.
  billedPeriods   Int                @default(0)
  nextBillingDate DateTime           @db.Date
  pausedAt        DateTime?
  /// Date de résiliation.
  endDate         DateTime?          @db.Date
  /// Montant d'une période, hors TVA (revenu récurrent).
  amountCents     Int                @default(0)
  notes           String             @default("")
  searchText      String             @default("")
  version         Int                @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("SubscriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?    @relation("SubscriptionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  items    SubscriptionItem[]
  invoices Invoice[]

  @@index([status, nextBillingDate])
  @@index([clientId])
  @@map("subscription")
}

model SubscriptionItem {
  id             String        @id @default(uuid(7))
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  position       Int
  catalogItemId  String?
  catalogItem    CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  label          String
  description    String        @default("")
  quantityMilli  Int
  unitPriceCents Int
  discountType   DiscountType?
  discountValue  Int           @default(0)
  vatRateBps     Int?

  @@index([subscriptionId])
  @@map("subscription_item")
}

// ---------------------------------------------------------------------------
// Tâches planifiées
// ---------------------------------------------------------------------------

/// Exécution des tâches quotidiennes (cron ou lancement manuel par un admin).
model TaskRun {
  id         String    @id @default(uuid(7))
  /// "cron" ou "manual".
  trigger    String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// Compte rendu : devis expirés, factures d'abonnement, relances…
  summary    Json?
  error      String    @default("")
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@map("task_run")
}

// ---------------------------------------------------------------------------
// Emails envoyés
// ---------------------------------------------------------------------------

enum EmailStatus {
  SENT
  FAILED
}

/// Historique des envois d'un devis ou d'une facture (réussis ou non).
model EmailLog {
  id         String      @id @default(uuid(7))
  quoteId    String?
  quote      Quote?      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  invoiceId  String?
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reminderId String?
  reminder   Reminder?   @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  recipients String[]
  /// Copie cachée (à l'expéditeur).
  bcc        String[]
  subject    String
  body       String
  /// Nom du PDF joint.
  attachment String
  status     EmailStatus
  /// Message d'erreur du serveur SMTP en cas d'échec.
  error      String      @default("")
  sentById   String?
  sentBy     User?       @relation(fields: [sentById], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([quoteId])
  @@index([invoiceId])
  @@map("email_log")
}

// ---------------------------------------------------------------------------
// Journal d'activité
// ---------------------------------------------------------------------------

/// « Marc a envoyé le devis D-2026-004 » : qui, quoi, sur quel document.
model ActivityLog {
  id         String   @id @default(uuid(7))
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Code de l'action, ex. "user.invited", "quote.sent".
  action     String
  entityType String?
  entityId   String?
  /// Libellé lisible de l'objet concerné, ex. "D-2026-004" ou "lea@devra.ch".
  label      String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("activity_log")
}

// ---------------------------------------------------------------------------
// Discussions entre utilisateurs (canal général et discussions par client)
// ---------------------------------------------------------------------------

/// Discussion : le canal général (sans client, identifiant fixe « general »,
/// voir src/domain/discussions.ts) ou une discussion sur un client.
model Discussion {
  id               String    @id @default(uuid(7))
  /// Client concerné ; vide pour le canal général.
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title            String
  createdById      String?
  createdBy        User?     @relation("DiscussionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  /// Date du dernier message : tri des discussions et repérage des messages non lus.
  lastMessageAt    DateTime  @default(now())
  /// Discussion avec le client, visible dans son espace client : l'identifiant
  /// du client (une seule par client). Vide pour les discussions internes,
  /// que le client ne voit jamais.
  portalClientId   String?   @unique
  /// Discussion avec le client : jusqu'où le client l'a lue.
  clientReadAt     DateTime?
  /// Dernier email envoyé au client pour l'avertir d'un nouveau message (un
  /// seul email tant qu'il n'a pas lu les messages précédents).
  clientNotifiedAt DateTime?

  messages DiscussionMessage[]
  reads    DiscussionRead[]

  @@index([clientId])
  @@index([lastMessageAt])
  @@map("discussion")
}

model DiscussionMessage {
  id           String       @id @default(uuid(7))
  discussionId String
  discussion   Discussion   @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Écrit par le client depuis son espace client (authorId vide).
  fromClient   Boolean      @default(false)
  body         String
  createdAt    DateTime     @default(now())
  attachments  StoredFile[]

  @@index([discussionId, createdAt])
  @@map("discussion_message")
}

/// Jusqu'où chaque utilisateur a lu chaque discussion (messages non lus).
model DiscussionRead {
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt   DateTime

  @@id([discussionId, userId])
  @@index([userId])
  @@map("discussion_read")
}

/// Appareil abonné aux notifications (Web Push : Windows, macOS, Android…).
model PushSubscription {
  id        String   @id @default(uuid(7))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Adresse du service de notification du navigateur (une par navigateur et appareil).
  endpoint  String   @unique
  p256dh    String
  auth      String
  /// Navigateur et système, ex. « Chrome · Windows ».
  device    String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscription")
}

/// Notification envoyée à un utilisateur, lue par l'application de bureau
/// (Windows, macOS) qui affiche les notifications du système. Gardée 30 jours.
model Notification {
  /// Numéro croissant : l'application demande « les notifications après n ».
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  url       String
  tag       String
  createdAt DateTime @default(now())

  @@index([userId, id])
  @@index([createdAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Espace client (devis, factures, abonnements, discussion avec l'équipe)
// ---------------------------------------------------------------------------

/// Accès d'un client à son espace : identifiant et mot de passe générés à la
/// création (mot de passe en Argon2id). Indépendant des comptes de l'équipe :
/// une session client ne donne jamais accès à l'outil de gestion.
model ClientAccount {
  id                String    @id @default(uuid(7))
  clientId          String    @unique
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Identifiant de connexion généré, ex. « k7m3-q9xp » (minuscules).
  login             String    @unique
  passwordHash      String
  /// Un accès désactivé ne permet plus de se connecter (sessions supprimées).
  active            Boolean   @default(true)
  /// Dernier changement du mot de passe par le client lui-même.
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?
  createdBy         User?     @relation("ClientAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sessions       ClientSession[]
  passwordResets ClientPasswordReset[]

  @@map("client_account")
}

/// Session ouverte dans l'espace client. Seule l'empreinte SHA-256 du jeton
/// (cookie) est enregistrée.
model ClientSession {
  id         String        @id @default(uuid(7))
  accountId  String
  account    ClientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash  String        @unique
  expiresAt  DateTime
  lastSeenAt DateTime      @default(now())
  ipAddress  String        @default("")
  userAgent  String        @default("")
  createdAt  DateTime      @default(now())

  @@index([accountId])
  @@map("client_session")
}

/// Lien « mot de passe oublié » de l'espace client (1 heure, usage unique).
model ClientPasswordReset {
  id        String        @id @default(uuid(7))
  accountId String
  account   ClientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([accountId])
  @@map("client_password_reset")
}

// ---------------------------------------------------------------------------
// Listes modifiables dans les paramètres
// ---------------------------------------------------------------------------

enum ListKind {
  /// États des clients (« À contacter », « Projet en cours »…).
  CLIENT_STAGE
  /// Catégories des dépenses.
  EXPENSE_CATEGORY
  /// Étapes proposées à la création d'un projet.
  PROJECT_STEP
}

/// Valeur d'une liste modifiable (Paramètres → Listes).
model ListItem {
  id        String   @id @default(uuid(7))
  kind      ListKind
  name      String
  position  Int      @default(0)
  /// Une valeur désactivée n'est plus proposée, mais reste affichée là où elle est utilisée.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients  Client[]
  expenses Expense[]

  @@unique([kind, name])
  @@index([kind, position])
  @@map("list_item")
}

// ---------------------------------------------------------------------------
// Fichiers (fiche client, espace client, discussions, justificatifs)
// ---------------------------------------------------------------------------

/// Fichier enregistré dans DATA_DIR/files (inclus dans les sauvegardes).
model StoredFile {
  id                String             @id @default(uuid(7))
  clientId          String?
  client            Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Pièce jointe d'un message de discussion.
  messageId         String?
  message           DiscussionMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Justificatif d'une dépense.
  expenseId         String?
  expense           Expense?           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  /// Justificatif d'un apport ou d'un remboursement d'associé (admins seulement).
  partnerMovementId String?
  partnerMovement   PartnerMovement?   @relation(fields: [partnerMovementId], references: [id], onDelete: Cascade)
  /// Nom d'origine (affiché et proposé au téléchargement).
  name              String
  mimeType          String
  size              Int
  /// Nom sur le disque (aléatoire).
  storageName       String             @unique
  /// Visible dans l'espace client.
  visibleToClient   Boolean            @default(false)
  uploadedById      String?
  uploadedBy        User?              @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Envoyé par le client depuis son espace.
  uploadedByClient  Boolean            @default(false)
  createdAt         DateTime           @default(now())

  @@index([clientId, createdAt])
  @@index([projectId])
  @@index([messageId])
  @@index([expenseId])
  @@index([partnerMovementId])
  @@map("stored_file")
}

// ---------------------------------------------------------------------------
// Projets : avancement et suivi du temps
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
}

model Project {
  id                String        @id @default(uuid(7))
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Devis d'origine (facultatif).
  quoteId           String?
  quote             Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  name              String
  description       String        @default("")
  status            ProjectStatus @default(ACTIVE)
  startDate         DateTime?     @db.Date
  dueDate           DateTime?     @db.Date
  /// Tarif horaire du projet (centimes, hors TVA) ; vide = tarif par défaut des paramètres.
  hourlyRateCents   Int?
  /// Budget en minutes (facultatif) : affiché à côté du temps passé.
  budgetMinutes     Int?
  /// L'avancement est toujours visible du client ; les heures seulement si coché.
  showHoursToClient Boolean       @default(true)
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String?
  createdBy         User?         @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  steps       ProjectStep[]
  timeEntries TimeEntry[]
  files       StoredFile[]
  expenses    Expense[]

  @@index([clientId])
  @@index([status])
  @@map("project")
}

model ProjectStep {
  id        String    @id @default(uuid(7))
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  position  Int
  label     String
  doneAt    DateTime?
  doneById  String?
  doneBy    User?     @relation(fields: [doneById], references: [id], onDelete: SetNull)

  @@index([projectId, position])
  @@map("project_step")
}

/// Temps passé (saisi, ou mesuré par le chronomètre tant que `startedAt` est rempli).
model TimeEntry {
  id          String    @id @default(uuid(7))
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  date        DateTime  @db.Date
  minutes     Int       @default(0)
  /// Chronomètre en cours depuis cette heure (un seul par utilisateur).
  startedAt   DateTime?
  description String    @default("")
  billable    Boolean   @default(true)
  /// Facture qui reprend ce temps (une fois facturé, il n'est plus proposé).
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId, date])
  @@index([projectId])
  @@index([userId, startedAt])
  @@index([invoiceId])
  @@map("time_entry")
}

// ---------------------------------------------------------------------------
// Dépenses et import des paiements bancaires
// ---------------------------------------------------------------------------

model Expense {
  id          String        @id @default(uuid(7))
  date        DateTime      @db.Date
  supplier    String        @default("")
  description String
  categoryId  String?
  category    ListItem?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Montant payé, TVA comprise (centimes).
  amountCents Int
  /// TVA comprise dans le montant (impôt préalable), si l'entreprise est assujettie.
  vatRateBps  Int?
  vatCents    Int           @default(0)
  method      PaymentMethod @default(BANK_TRANSFER)
  /// Dépense liée à un client ou un projet (marge par projet).
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes       String        @default("")
  searchText  String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdById String?
  createdBy   User?         @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  receipts StoredFile[]

  @@index([date])
  @@index([categoryId])
  @@index([clientId])
  @@map("expense")
}

/// Sorte de mouvement d'argent entre un associé et l'entreprise.
enum PartnerMovementKind {
  /// Apport en capital (définitif).
  CAPITAL_IN
  /// Prêt de l'associé à l'entreprise (à rembourser).
  LOAN_IN
  /// Remboursement du prêt par l'entreprise.
  LOAN_OUT
  /// Retrait de capital (l'entreprise rend de l'argent apporté).
  CAPITAL_OUT
}

/// Argent investi par un associé dans l'entreprise, ou rendu à un associé.
/// Visible et modifiable par les admins seulement.
model PartnerMovement {
  id          String              @id @default(uuid(7))
  /// L'associé : un utilisateur de l'outil.
  partnerId   String
  partner     User                @relation("PartnerMovements", fields: [partnerId], references: [id], onDelete: Restrict)
  kind        PartnerMovementKind
  date        DateTime            @db.Date
  /// Montant, toujours positif (le sens est donné par `kind`), en centimes.
  amountCents Int
  description String              @default("")
  notes       String              @default("")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdById String?
  createdBy   User?               @relation("PartnerMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  receipts StoredFile[]

  @@index([date])
  @@index([partnerId])
  @@map("partner_movement")
}

/// Relevé bancaire importé (fichier camt.053 / camt.054 de l'e-banking).
model BankImport {
  id           String   @id @default(uuid(7))
  fileName     String
  /// Opérations au crédit lues dans le fichier, et paiements enregistrés.
  credits      Int
  paymentCount Int
  createdAt    DateTime @default(now())
  createdById  String?
  createdBy    User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  transactions BankTransaction[]

  @@index([createdAt])
  @@map("bank_import")
}

/// Opération d'un relevé enregistrée comme paiement : jamais importée deux fois.
model BankTransaction {
  id                String     @id @default(uuid(7))
  importId          String
  import            BankImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Identifiant unique de l'opération (référence de la banque, ou empreinte de ses données).
  key               String     @unique
  bookingDate       DateTime   @db.Date
  amountCents       Int
  creditorReference String     @default("")
  debtorName        String     @default("")
  remittance        String     @default("")
  /// Paiement créé : supprimer le paiement libère l'opération (elle peut être réimportée).
  paymentId         String     @unique
  payment           Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("bank_transaction")
}

// ---------------------------------------------------------------------------
// Sites des clients : renouvellements et surveillance
// ---------------------------------------------------------------------------

enum SiteStatus {
  UNKNOWN
  UP
  DOWN
}

model Site {
  id               String    @id @default(uuid(7))
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name             String
  /// Adresse surveillée, ex. https://www.exemple.ch
  url              String
  /// Nom de domaine, ex. exemple.ch
  domain           String
  registrar        String    @default("")
  domainExpiresAt  DateTime? @db.Date
  /// Date d'expiration lue automatiquement dans le registre (RDAP) quand il la publie.
  domainExpiryAuto Boolean   @default(true)
  domainCheckedAt  DateTime?
  hostingProvider  String    @default("")
  hostingRenewsAt  DateTime? @db.Date
  notes            String    @default("")

  /// Surveillance : vérification toutes les quelques minutes.
  monitor            Boolean    @default(true)
  showStatusToClient Boolean    @default(true)
  status             SiteStatus @default(UNKNOWN)
  statusChangedAt    DateTime?
  lastCheckAt        DateTime?
  lastResponseMs     Int?
  lastError          String     @default("")
  /// Échecs consécutifs : l'alerte part au deuxième (évite les fausses alertes).
  failures           Int        @default(0)
  sslExpiresAt       DateTime?

  /// Rappels déjà envoyés (pour quelle échéance) : un seul rappel par échéance.
  domainReminderFor  DateTime? @db.Date
  hostingReminderFor DateTime? @db.Date
  sslReminderFor     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents SiteIncident[]

  @@index([clientId])
  @@index([monitor])
  @@map("site")
}

/// Période d'indisponibilité d'un site (pour l'historique et le taux de disponibilité).
model SiteIncident {
  id        String    @id @default(uuid(7))
  siteId    String
  site      Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  error     String    @default("")

  @@index([siteId, startedAt])
  @@map("site_incident")
}

// ---------------------------------------------------------------------------
// Calendrier
// ---------------------------------------------------------------------------

/// Adresse secrète d'abonnement au calendrier (Outlook, Google Agenda) : une par utilisateur.
model CalendarFeed {
  id        String   @id @default(uuid(7))
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())

  @@map("calendar_feed")
}
